# Atlas environment template — copy to `.env` and adjust per machine.
# `.env` is gitignored; never commit secrets or absolute machine paths.

# === Backend (atlas-server) ===

# SQLite database. Defaults to `<cwd>/atlas-data/atlas.db` if unset.
# Use absolute paths in production.
DATABASE_URL=sqlite://./atlas-data/atlas.db

# CORS origin for the web frontend.
WEB_ORIGIN=http://localhost:3000

# Port the Rust server listens on. Default: 4000.
PORT=4000

# Atlas CLI bin directory (atlas-msg, atlas-ls, etc.) prepended to PATH
# of every PTY spawned. Defaults to `<server-binary-dir>/../bin`.
# ATLAS_BIN_DIR=/absolute/path/to/atlas/apps/atlas-server/bin

# URL injected into spawned shells as ATLAS_SERVER_URL so the CLI can
# reach this server from inside terminals. Default: http://localhost:4000.
# ATLAS_SERVER_URL=http://localhost:4000

# Bearer token required by ALL REST API routes. Generate with `openssl rand -hex 32`.
# Leave unset in dev to disable auth (NOT for production).
# Must match VITE_API_TOKEN in apps/web/.env.
# ATLAS_API_TOKEN=

# Bearer token required by /api/mcp. Generate with `openssl rand -hex 32`.
# Leave unset in dev to disable auth (NOT for production).
# ATLAS_MCP_TOKEN=

# === Frontend (apps/web) ===

# Note: Vite reads only `apps/web/.env` for VITE_* vars, not this root file.
# See apps/web/.env.example.
