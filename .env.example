# Copy to .env and edit. Every value here is a default or an example —
# nothing in this file is a real credential.
# Full reference: docs/reference/environment.md

# ─── Core ────────────────────────────────────────────────────────────
# One shared bearer for POST /api/mcp. Anyone holding it can call every
# tool. Required — set ATLAS_MCP_TOKEN_ALLOW_UNSET=true only for local
# experiments, and pair it with a loopback listen address.
ATLAS_MCP_TOKEN=change-me-to-something-random

# 0.0.0.0:4000 is the default and the right choice inside a container.
# On a workstation prefer loopback: Atlas drives PTYs and holds your
# sessions, and that need not answer on every interface.
ATLAS_LISTEN_ADDR=127.0.0.1:4000

# docker-compose overrides the two above: it binds 0.0.0.0 inside the
# container and keeps the database on the mounted volume. Change the
# published host port with ATLAS_HOST_PORT instead.
#ATLAS_HOST_PORT=4000

ATLAS_DB_PATH=./atlas-data/atlas.db

# Sessions store a *relative* path resolved against this, which is what
# lets the same session mean the right directory on two machines.
ATLAS_WORKSPACE_ROOT=~/dev

# ─── External tracker (optional) ─────────────────────────────────────
# Unset ATLAS_TRACKER_KIND and the tracker tools report "disabled"
# rather than failing obscurely.
#ATLAS_TRACKER_KIND=gitlab
#ATLAS_TRACKER_URL=https://gitlab.com

# A PATH to a file, not the token itself. Atlas is not a credential
# store, so the token stays where you already keep it — and
# out of `docker inspect`, process listings and shell history.
#ATLAS_TRACKER_TOKEN_FILE=~/.config/atlas/gitlab-token

#ATLAS_TRACKER_MIRROR_PROJECTS=your-org/your-project
#ATLAS_TRACKER_MIRROR_INTERVAL_SECS=300

# ─── GitLab OAuth (optional) ─────────────────────────────────────────
# All four or none. Setting some but not all is a startup error, not a
# partial enable. With none set, the OAuth routes are not mounted at
# all — they 404 rather than answering "not configured".
#ATLAS_OAUTH_GITLAB_CLIENT_ID=
#ATLAS_OAUTH_GITLAB_CLIENT_SECRET=
#ATLAS_OAUTH_GITLAB_REDIRECT_URI=https://atlas.example.com/api/auth/oauth/gitlab/callback
#ATLAS_OAUTH_STATE_SECRET=
