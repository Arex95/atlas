# Web frontend (Vite) environment template.
# Copy to `apps/web/.env` and adjust as needed.

# Backend URL the browser talks to.
VITE_SERVER_URL=http://localhost:4000

# Bearer token sent on every API request. Must match ATLAS_API_TOKEN in .env.
# Leave unset in dev if the server also has ATLAS_API_TOKEN unset.
# VITE_API_TOKEN=
